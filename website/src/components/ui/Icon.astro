---
import { icons, type IconName } from '../../data/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, ...attributes } = Astro.props;
---

<svg
  {...attributes}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <Fragment set:html={icons[name]} />
</svg>

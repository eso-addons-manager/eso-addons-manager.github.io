---
import type { NavLink } from '../../data/navigation';

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

{links.map(({ id, href, label }) => (
  <li><a href={href} data-section-link={id}>{label}</a></li>
))}

<style>
  a {
    display: block;
    padding: var(--nav-link-padding, var(--space-2) var(--space-3));
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--nav-link-font-size, var(--font-size-sm));
    font-weight: var(--font-weight-medium);
    line-height: var(--nav-link-line-height, var(--line-height-sm));
    transition: color var(--duration-hover) var(--ease-standard);
  }

  a:hover,
  a[aria-current="location"] {
    color: var(--color-bronze);
  }

  a[aria-current="location"] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

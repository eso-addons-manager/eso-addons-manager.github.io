---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { getScreenshotPreview } from '../../data/screenshot-previews';
import type { SiteContent } from '../../data/types';

interface Props {
  content: SiteContent['screenshots'];
}

const { content } = Astro.props;
const items = await Promise.all(content.items.map(async (item) => ({
  ...item,
  preview: await getScreenshotPreview(item.src),
})));
---

<Section id="screenshots" toned>
  <SectionHeading id="screenshots-title" title={content.title} subtitle={content.subtitle} />
  <ul class="card-grid" role="list">
    {items.map((item) => (
      <li>
        <a href={item.src} target="_blank" rel="noopener noreferrer">
          <div class="preview">
            <img
              src={item.src}
              srcset={item.preview.srcset}
              sizes={item.preview.srcset && '(min-width: 1280px) 596px, (min-width: 1024px) calc(50vw - 44px), (min-width: 640px) calc(50vw - 36px), calc(100vw - 42px)'}
              width={item.preview.width}
              height={item.preview.height}
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
            <span class="enlarge"><Icon name="maximize" /></span>
          </div>
          <div class="caption">
            <h3>{item.title}</h3>
            <p class="text-sm text-muted text-relaxed">{item.description}</p>
            <span class="view-full-size text-xs text-accent">
              <Icon name="maximize" size={14} />{content.viewFullSize}
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  ul {
    gap: var(--space-5);
  }

  li {
    overflow: hidden;
    border: var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--color-card);
  }

  a {
    display: block;
    border-radius: var(--radius-lg);
  }

  a:focus-visible {
    outline: 2px solid var(--color-bronze);
    outline-offset: -2px;
    box-shadow: none;
  }

  .preview {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1919 / 1040;
    background: var(--color-background);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--duration-gallery) var(--ease-standard);
  }

  a:hover img {
    transform: scale(1.02);
  }

  .enlarge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-2);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-background) 90%, transparent);
    color: var(--color-bronze);
  }

  .caption {
    padding: var(--space-4);
    border-top: var(--border-default);
  }

  h3 {
    line-height: 1.5rem;
    transition: color 150ms var(--ease-standard);
  }

  a:hover h3 {
    color: var(--color-bronze);
  }

  p {
    margin-top: var(--space-2);
  }

  .view-full-size {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-weight: var(--font-weight-medium);
  }

  @media (min-width: 640px) {
    .caption {
      padding: var(--space-5);
    }
  }
</style>
